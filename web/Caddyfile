# The static UI. Built files have a hash in their name, so they can be kept for good, and a missing one is a 404 rather
# than index.html: after a deploy, an open tab may ask for a file that's gone.
(ui) {
	handle /assets/* {
		root * /srv
		@built file
		header @built Cache-Control "private, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# SITE_ADDRESS e.g. aniweb.eu (automatic HTTPS) or http://localhost:8088 for local testing.
{$SITE_ADDRESS:http://localhost:8088} {
	encode gzip

	# One "user bcrypt-hash" per line, mounted from deploy/caddy/users (not in git).
	basic_auth {
		import /etc/caddy/users
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	import ui
}

# The AniList copy (docker-compose.anilist.yml), e.g. staging.aniweb.eu. Without that overlay this block listens
# only inside the container on its default address, and nothing reaches it.
{$STAGING_ADDRESS:http://localhost:8089} {
	encode gzip

	basic_auth {
		import /etc/caddy/users
	}

	handle /api/* {
		reverse_proxy api-anilist:8000
	}

	import ui
}

# Old addresses that redirect to the current ones, such as app.mal-graph.eu after the rename to Aniweb, or www.aniweb.eu.
# Each variable may list several addresses separated by commas. Unset, these blocks only listen inside the container.
{$OLD_SITE_ADDRESS:http://localhost:8090} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

{$OLD_STAGING_ADDRESS:http://localhost:8091} {
	redir https://{$STAGING_ADDRESS}{uri} permanent
}
