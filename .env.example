# Register a free app at https://myanimelist.net/apiconfig and paste the Client ID
MAL_CLIENT_ID=
# Your MAL username (list must be public)
MAL_USERNAME=
# Memgraph Bolt endpoint (docker-compose default)
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
# Directory for cached Jikan responses
CACHE_DIR=data/cache
# Jikan base URL. Default is the self-hosted instance from docker-compose (recommended);
# the public https://api.jikan.moe/v4 works too but is frequently throttled by MAL.
JIKAN_BASE=http://localhost:8080/v4
# Credentials for the MongoDB behind the self-hosted Jikan (local containers only)
MONGO_USER=jikan
MONGO_PASSWORD=jikan
