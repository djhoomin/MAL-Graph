# Register a free app at https://myanimelist.net/apiconfig and paste the Client ID
MAL_CLIENT_ID=
# Only for MAL apps of type "web". Apps of type "other" have no secret.
MAL_CLIENT_SECRET=
# Default user for the CLI, and the API's only user while sign-in is off (local development)
MAL_USERNAME=
# Where the site is served. Setting it turns on "Sign in with MyAnimeList", and the MAL app's
# App Redirect URL must then be {PUBLIC_URL}/api/auth/callback (http://localhost:5173/api/auth/callback in dev).
PUBLIC_URL=
# Signs session cookies. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Memgraph Bolt endpoint (docker-compose default)
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
# Directory for cached Jikan responses
CACHE_DIR=data/cache
# Jikan base URL. Default is the self-hosted instance from docker-compose (recommended);
# the public https://api.jikan.moe/v4 works too but is frequently throttled by MAL.
JIKAN_BASE=http://localhost:8080/v4
# Credentials for the MongoDB behind the self-hosted Jikan (local containers only)
MONGO_USER=jikan
MONGO_PASSWORD=jikan

# --- production only (docker-compose.prod.yml) ---
# Public hostname Caddy serves (automatic HTTPS). For a local test use http://localhost:8088
SITE_ADDRESS=mal.example.com

# --- "Ask the graph" agent (optional) ---
# OpenRouter key from https://openrouter.ai/keys ; any tool-capable model id works
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Questions per signed-in user per day (UTC); 0 means no cap. MAL_USERNAME is always unlimited.
ASK_DAILY_LIMIT=30
# Comma list of further usernames with no daily cap
ASK_UNLIMITED_USERS=
