      "css": ".ds-fab{font:400 13px system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;background:var(--float);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--border);box-shadow:var(--float-shadow);color:var(--text);display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 12px;border-radius:20px;cursor:pointer}.ds-fab:hover{border-color:var(--accent)}.ds-fab:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
