      "css": ".ds-game{font:400 13px system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;display:flex;flex-direction:column;align-items:center;gap:6px;width:150px;padding:12px;color:var(--text);background:var(--panel);border:2px solid var(--border);border-radius:14px;cursor:pointer;transition:border-color .15s,transform .1s}.ds-game:hover{border-color:var(--accent)}.ds-game:active{transform:scale(.98)}.ds-art{width:100%;aspect-ratio:225/330;border-radius:10px;background:#20242f}.ds-game strong{font-size:15px}.ds-sub{color:var(--muted)}.ds-game:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
