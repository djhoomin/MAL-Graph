      "description": "Filters and list statuses.",
      "html": "<button class=\"ds-chip\"><i></i>completed</button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:5px;font:400 11px system-ui,sans-serif;color:var(--text);background:#20242f;border:1px solid var(--border);border-radius:12px;padding:2px 7px;cursor:pointer}.ds-chip:hover{border-color:var(--accent)}.ds-chip i{width:8px;height:8px;border-radius:50%;background:#199e70}.ds-chip:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Stat Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "A figure in Insights.",
      "html": "<div class=\"ds-stat\"><b>8.18</b><span>My mean score</span></div>",
      "css": ".ds-stat{width:180px;background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-family:system-ui,sans-serif;color:var(--text)}.ds-stat b{display:block;font-size:30px;font-weight:600;line-height:1.1}.ds-stat span{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}"
