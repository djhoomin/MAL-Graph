      "description": "Search at the top of the canvas.",
      "html": "<label class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m16 16 5 5\"/></svg><input placeholder=\"Search anime, characters, people…\" aria-label=\"Search\"></label>",
      "css": ".ds-search{background:var(--float);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--border);box-shadow:var(--float-shadow);color:var(--text);display:flex;align-items:center;gap:8px;width:300px;height:40px;padding:0 12px;border-radius:20px}.ds-search:hover,.ds-search:focus-within{border-color:var(--accent)}.ds-search input{flex:1;min-width:0;border:0;background:none;outline:0;color:var(--text);font:400 14px system-ui,sans-serif}.ds-search input::placeholder{color:var(--muted);opacity:1}"
