  "narrative": {
    "northStar": "The Night Sky Chart",
    "overview": "Aniweb is a chart of a night sky. Anime, characters and people are points of light on a near-black field, and the lines between them are the constellations. The background stays dark and even so the points can be read, and almost all of the colour on screen belongs to a node, a connection, a list status or a piece of cover art.\n\nThe voice is playful and dark. The interface is compact, and its energy comes from the games, the cards and the covers. Controls float over the chart in translucent dark panels and leave the middle of the screen to the graph.\n\nThe system rejects three looks. It isn't a busy fan site with banners, cluttered sidebars or mascots. It isn't neon cyberpunk with glowing text, neon gradients or scanlines. It isn't a corporate dashboard with white cards and pale blue.",
    "keyCharacteristics": [
      "A single dark theme on a near-black background",
      "Colour used as a code for kinds of nodes, connections and list statuses",
      "Cover art and character portraits as the main imagery",
      "Compact controls in the system typeface",
      "Translucent, blurred controls floating over a full-screen canvas"
    ],
    "rules": [
      {
        "name": "The Coded Colour Rule",
        "body": "A colour that stands for a kind of node, a connection or a list status keeps that meaning on every page.",
        "section": "colors"
      },
      {
        "name": "The Dark Text on Blue Rule",
        "body": "Text on Polestar Blue is Midnight, at 5.9:1. White on it only reaches 3.2:1.",
        "section": "colors"
      },
      {
        "name": "The Dark Sky Rule",
        "body": "Large surfaces use the neutrals. Bright colour appears in points, lines, rings, bars and controls.",
        "section": "colors"
      },
      {
        "name": "The Steady Figures Rule",
        "body": "Numbers that line up in tables, charts and scores use tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Sixteen Pixel Rule",
        "body": "Text fields and dropdowns are 16px on touch screens, so iOS doesn't zoom in when they get focus. Pinch zoom is never turned off.",
        "section": "typography"
      },
      {
        "name": "The Soft Shadow Rule",
        "body": "Shadows are dark and soft. They're never coloured and never a glow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the background Midnight (#0f1117) and let covers, portraits and nodes bring the colour.",
      "**Do** reuse the colour a kind of node, connection or status already has.",
      "**Do** give controls over the canvas the translucent fill, 12px blur, border and Float shadow.",
      "**Do** keep 12px plus the safe area between floating controls and the edge of the screen.",
      "**Do** make presses visible, as the game cards do.",
      "**Do** use tabular figures where numbers line up."
    ],
    "donts": [
      "**Don't** make it look like a busy fan site with crowded banners, cluttered sidebars or mascot decoration.",
      "**Don't** use neon cyberpunk effects such as glowing text, neon gradients or scanlines.",
      "**Don't** make it look like a corporate dashboard with white cards and pale blue accents.",
      "**Don't** use a coded colour for decoration.",
      "**Don't** let controls cover the middle of the canvas while the visitor explores it."
    ]
  }
}